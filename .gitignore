/data

# The React app in web/. node_modules is ~100 MB of installed packages and
# dist/ is regenerated by `npm run build` - neither is source. web/package.json
# and web/package-lock.json ARE source and must be committed, because the
# lockfile is what makes the dependency graph reproducible.
web/node_modules
web/dist

# Build artefacts of `npm run check` (web/check.mjs bundles ssr-check.jsx).
# web/ssr-check.jsx and web/_snapshot.json are source: the check needs the
# captured payload to have something to render against.
web/_ssr-check.mjs

# Scratch capture used while bringing the API up. Not an input to anything.
logs/_server_smoke.txt
logs/_server_web.txt

# A track record kept aside while testing. The live one is
# models/dashboard_log_<model>.json; this preserves history that a test run
# wrote, so nothing is destroyed, without letting it read as live evidence.
models/*.json.bak

# The projection store. Local state that accumulates on whatever machine the
# dashboard runs on - not source, and not a result anyone should read out of
# the repository. -wal/-shm are SQLite's own sidecars.
models/*.db
models/*.db-wal
models/*.db-shm

# Python
__pycache__/
*.pyc
